# Copy this file to backend/.env and fill in your Supabase project values.
# Supabase Dashboard > Project Settings > API (or "API Keys").
# Use the SECRET / service_role key: it stays on this laptop (backend only),
# never put it in the frontend or commit it to git.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-secret-or-service-role-key
